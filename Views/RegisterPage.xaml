<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mika2027.Views.RegisterPage"
             Title="Sign Up">

    <ScrollView>

        <Grid Padding="35,20">

            <VerticalStackLayout Spacing="8">

                    <!-- Full Name -->
                    <Entry x:Name="fullName"
                           Placeholder="Enter full name"
                           MaxLength="50" />

                    <Label x:Name="errorMsgFullName"
                           TextColor="Red"
                           FontSize="10" />


                    <!-- Username -->
                    <Entry x:Name="userName"
                           Placeholder="Enter Username"
                           MaxLength="50" />

                    <Label x:Name="errorMsgName"
                           TextColor="Red"
                           FontSize="10" />


                    <!-- Email -->
                    <Entry x:Name="email"
                           Placeholder="Enter Email"
                           MaxLength="100"
                           Keyboard="Email" />

                    <Label x:Name="errorMsgEmail"
                           TextColor="Red"
                           FontSize="10" />


                    <!-- Password -->
                    <Grid ColumnDefinitions="*,45">

                        <Entry x:Name="password1"
                               Placeholder="Enter password"
                               MaxLength="50"
                               IsPassword="True" />

                        <Button Grid.Column="1"
                                Text="O"
                                Padding="0"
                                Pressed="Show_Password"
                                Released="Hide_Password" />

                    </Grid>

                    <Label x:Name="errorMsgPass"
                           TextColor="Red"
                           FontSize="10" />


                    <!-- Confirm Password -->
                    <Grid ColumnDefinitions="*,45">

                        <Entry x:Name="password2"
                               Placeholder="Confirm password"
                               MaxLength="50"
                               IsPassword="True" />

                        <Button Grid.Column="1"
                                Text="O"
                                Padding="0"
                                Pressed="Show_Confirm_Password"
                                Released="Hide_Confirm_Password" />

                    </Grid>

                    <Label x:Name="errorMsgConfirm"
                           TextColor="Red"
                           FontSize="10" />


                    <!-- Link to Login -->
                    <Button x:Name="sendToLogin"
                            Text="Already have an account? Login here"
                            BackgroundColor="Transparent"
                            TextColor="Black"
                            FontSize="14"
                            Clicked="LinkToLogin"
                            HorizontalOptions="Center"
                            Margin="0,10,0,0" />


                    <!-- Register Button -->
                    <Button x:Name="RegisterButton"
                            Text="Send"
                            Clicked="Button_Clicked_Register"
                            WidthRequest="120"
                            HorizontalOptions="Center"
                            CornerRadius="25" />

                </VerticalStackLayout>


        </Grid>

    </ScrollView>

</ContentPage>