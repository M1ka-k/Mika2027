<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mika2027.Views.RegisterPage"
             Title="Sign Up">

    <ScrollView>
        <Grid Padding="35,20">
            <VerticalStackLayout Spacing="8">

                <Label x:Name="errorMsgGenral"
                       Style="{StaticResource ErrorLabel}"/>

                <Entry x:Name="fullName"
                       Placeholder="Enter full name"
                       MaxLength="50" />

                <Label x:Name="errorMsgFullName"
                       Style="{StaticResource ErrorLabel}" />

                <Entry x:Name="email"
                       Placeholder="Enter Email"
                       MaxLength="100"
                       Keyboard="Email" />

                <Label x:Name="errorMsgEmail"
                       Style="{StaticResource ErrorLabel}" />

                <Grid ColumnDefinitions="*,45">

                    <Entry x:Name="password1"
                           Placeholder="Enter password"
                           MaxLength="50"
                           IsPassword="True" />

                    <Button Grid.Column="1"
                            x:Name="togglePassBtn"
                            Text="◠"
                            Padding="0"
                            CornerRadius="30"
                            BackgroundColor="{x:StaticResource MikaPrimary}"
                            Pressed="ShowPassword"
                            Released="HidePassword" />

                </Grid>

                <Label x:Name="errorMsgPass"
                       Style="{StaticResource ErrorLabel}" />

                <Entry x:Name="password2"
                       Placeholder="Confirm password"
                       MaxLength="50"
                       IsPassword="True" />

                <Label x:Name="errorMsgConfirm"
                       Style="{StaticResource ErrorLabel}" />

                <Button x:Name="sendToLogin"
                        Text="Already have an account? Login here"
                        Style="{StaticResource LinkButton}"
                         />

                <Button x:Name="RegisterButton"
                        Text="SignUp"
                        Clicked="ButtonClickedRegister"
                        HorizontalOptions="Center"
                        Style="{StaticResource SuperButton}" />

            </VerticalStackLayout>
        </Grid>
    </ScrollView>

</ContentPage>