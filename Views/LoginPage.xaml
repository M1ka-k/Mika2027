<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mika2027.Views.LoginPage"
             Title="Login">

    <ScrollView>

        <Grid Padding="35,20">


            <VerticalStackLayout Spacing="8">

                <Entry x:Name="userName"
                           Placeholder="Enter Username"
                           MaxLength="50" />

                <Label x:Name="errorMsgName"
                           TextColor="Red"
                           FontSize="10" />

                <Grid ColumnDefinitions="*,45">

                    <Entry x:Name="password"
                               Placeholder="Enter password"
                               MaxLength="50"
                               IsPassword="True" />

                    <Button Grid.Column="1"
                                Text="O"
                                Padding="0"
                                Pressed="Show_Password"
                                Released="Hide_Password" />

                </Grid>

                <Label x:Name="errorMsgPass"
                           TextColor="Red"
                           FontSize="10" />

                <Button x:Name="sendToReg"
                            Text="Don't have an account? Sign Up here"
                            BackgroundColor="Transparent"
                            TextColor="Black"
                            FontSize="14"
                            Clicked="LinkToReg"
                            HorizontalOptions="Center"
                            Margin="0,10,0,0" />

                <Button x:Name="LoginButton"
                            Text="Send"
                            Clicked="Button_Clicked_Login"
                            WidthRequest="120"
                            HorizontalOptions="Center"
                            CornerRadius="25" />

            </VerticalStackLayout>

        </Grid>

    </ScrollView>

</ContentPage>