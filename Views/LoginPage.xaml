<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mika2027.Views.LoginPage"
             Title="Login">

    <ScrollView>

        <Grid Padding="35,20">

            <VerticalStackLayout Spacing="9">

                <Label x:Name="errorMsgGenral"
                       Style="{StaticResource ErrorLabel}" />

                <Entry x:Name="userName"
                       Placeholder="Enter Username"
                       MaxLength="50" />

                <Label x:Name="errorMsgName"
                        Style="{StaticResource ErrorLabel}"  />

                <Grid ColumnDefinitions="*,45">

                    <Entry x:Name="password"
                           Placeholder="Enter password"
                           MaxLength="50"
                           IsPassword="True" />

                    <Button Grid.Column="1"
                            Text="◠"
                            Padding="0"
                            BackgroundColor="{x:StaticResource MikaPrimary}"
                            CornerRadius="25"
                            Pressed="ShowPassword"
                            Released="HidePassword" />

                </Grid>

                <Label x:Name="errorMsgPass"
                       Style="{StaticResource ErrorLabel}"/>

                <Button x:Name="sendToReg"
                        Text="Don't have an account? Sign Up here"
                        Clicked="LinkToReg"
                        HorizontalOptions="Center"
                        Style="{StaticResource LinkButton}"
                 />

                <Button x:Name="LoginButton"
                    Text="Login"
                    Style="{StaticResource SuperButton}"
                    Clicked="ButtonClickedLogin" />

            </VerticalStackLayout>

        </Grid>

    </ScrollView>

</ContentPage>