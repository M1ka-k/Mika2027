<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mika2027.Views.LoginPage"
             Title="LoginPage">
    <Grid RowDefinitions="*,Auto" >
        <VerticalStackLayout Spacing="10" Grid.Row ="0">
            <Entry
                Placeholder="Enter your username"
                MaxLength="50"
                x:Name="userName"
                 />
            <Label
                x:Name="errorMsgName" 
                TextColor ="Red"
                FontSize="Micro"
            />

            <Grid   ColumnDefinitions="*, auto">
                <Entry
                    Placeholder="Enter your password"
                    MaxLength="50"
                    IsPassword="True"
                    x:Name="password"
                />
                <Button
                    Grid.Column="1" Text="O"
                    Pressed="Show_Password"
                    Released="Hide_Password"
                />

            </Grid>
            <Label
                x:Name="errorMsgPass"
                TextColor ="Red"
                FontSize="Micro"
            />

        </VerticalStackLayout>
        <VerticalStackLayout  Grid.Row="2">
            <Button
    
                x:Name = "sendToReg"
                Text="Don't have an account Register"
                BackgroundColor="Transparent"
                TextColor="Purple"
                Clicked= "LinkToReg"
                />

            <Button
                
         Grid.Row="2"
         x:Name = "LoginButton"
         Text="Login"
         Clicked="Button_Clicked_Login"
         
        />
        </VerticalStackLayout>


    </Grid>
</ContentPage>